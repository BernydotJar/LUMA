{
  "schemaVersion": "luma.product-acceptance.v1",
  "project": "LUMA",
  "customerContext": {
    "persona": "cliente empresarial del sector agroquimico (escenario de prueba, no cliente identificado)",
    "validatedWithCustomer": false,
    "assumptions": [
      "Necesita capacitar equipo comercial, colaboradores y distribuidores con derechos por programa/cohorte",
      "Tiene cursos evergreen y sesiones high-ticket en vivo, con alta diversidad de cursos",
      "Exige soporte, automatizacion, seguimiento, certificados y privacidad; confirmar prioridades y requisitos del sector"
    ]
  },
  "policy": {
    "definitionOfDone": "Source + usable authenticated UI action + complete business outcome with server readback/security/recovery + exact published version + human/UAT evidence",
    "uiHttp200IsNotAcceptance": true,
    "e2eGreenIsNotModuleComplete": true,
    "dataDisplayIsNotAnOperationalAction": true,
    "minimumJourneyWidth": "every mandatory action and all requested variants, negative/recovery, live verified role",
    "productionWritesAllowed": false,
    "manualReleaseGates": [
      "customer_requirements_confirmed",
      "business_owner_uat_signed",
      "manual_accessibility_signed",
      "privacy_and_abuse_signed",
      "production_route_coverage_signed"
    ]
  },
  "modules": [
    {
      "id": "institution-onboarding",
      "title": "Solicitud, dos revisores, invitacion y primer administrador",
      "required": true,
      "actions": [
        {
          "id": "ORG-01",
          "title": "Solicitar academia y conocer el estado",
          "actor": "owner",
          "path": "/academia/solicitud",
          "uiFiles": [
            "src/app/academia/solicitud/page.tsx"
          ],
          "serviceFiles": [
            "src/app/api/institutions/applications/route.ts"
          ],
          "serverOutcome": "Solicitud persistida en tenant de staging",
          "negative": "correo sin verificar rechazado",
          "recovery": "reintentar error transitorio",
          "requiredVariants": [
            "first_customer"
          ]
        },
        {
          "id": "ORG-02",
          "title": "Revisar y aprobar por dos operadores distintos",
          "actor": "platform_reviewer",
          "path": "/plataforma/solicitudes",
          "uiFiles": [
            "src/app/plataforma/solicitudes/page.tsx"
          ],
          "serviceFiles": [
            "src/app/api/platform/institution-applications/[applicationId]/decisions/route.ts"
          ],
          "serverOutcome": "Dos decisiones y auditoria separadas",
          "negative": "mismo revisor no puede aprobarse",
          "recovery": "rechazo e invitacion revocable",
          "requiredVariants": [
            "two_operators"
          ]
        },
        {
          "id": "ORG-03",
          "title": "Aceptar invitacion segura",
          "actor": "owner",
          "path": "/academia/invitacion",
          "uiFiles": [
            "src/app/academia/invitacion/page.tsx"
          ],
          "serviceFiles": [
            "src/app/api/institutions/invitations/accept/route.ts"
          ],
          "serverOutcome": "Invitacion consumida una sola vez",
          "negative": "invitacion ajena o repetida rechazada",
          "recovery": "reenvio y expiracion",
          "requiredVariants": [
            "expired_token"
          ]
        },
        {
          "id": "ORG-04",
          "title": "Asignar primer administrador y acceder",
          "actor": "platform_operator",
          "path": "/academia/primer-curso",
          "uiFiles": [
            "src/app/academia/primer-curso/page.tsx"
          ],
          "serviceFiles": [
            "src/lib/institutions/approval-store.ts"
          ],
          "serverOutcome": "Rol por tenant verificado con reingreso",
          "negative": "suplantacion y cross-tenant rechazados",
          "recovery": "reconciliar rol en fallo parcial",
          "requiredVariants": [
            "verified_identity"
          ]
        }
      ]
    },
    {
      "id": "catalog-course-ops",
      "title": "Catalogo con muchos cursos y cohortes live/evergreen",
      "required": true,
      "actions": [
        {
          "id": "CAT-01",
          "title": "Crear primer curso y cohortes",
          "actor": "tenant_admin",
          "path": "/academia/primer-curso",
          "uiFiles": [
            "src/app/academia/primer-curso/page.tsx"
          ],
          "serviceFiles": [
            "src/app/api/programs/admin/offerings/route.ts"
          ],
          "serverOutcome": "Cohorte versionada en Firestore, inicialmente draft",
          "negative": "admin de otra academia denegado",
          "recovery": "edicion/duplicado controlado",
          "requiredVariants": [
            "evergreen",
            "high_ticket_live"
          ]
        },
        {
          "id": "CAT-02",
          "title": "Ver y gestionar 1, 10 y 50 cursos por nombre",
          "actor": "tenant_admin",
          "path": "/studio/programs",
          "uiFiles": [
            "src/app/studio/programs/page.tsx",
            "src/components/academic-operations-console.tsx"
          ],
          "serviceFiles": [
            "src/app/api/programs/admin/offerings/route.ts"
          ],
          "serverOutcome": "Listado y busqueda reales, persistencia y paginacion",
          "negative": "no leer otro tenant",
          "recovery": "estado vacio, carga y error",
          "requiredVariants": [
            "one_course",
            "ten_courses",
            "fifty_courses"
          ]
        },
        {
          "id": "CAT-03",
          "title": "Asignar instructores, horarios y cohortes",
          "actor": "tenant_admin",
          "path": "/studio/programs",
          "uiFiles": [
            "src/app/studio/programs/page.tsx",
            "src/components/academic-operations-console.tsx"
          ],
          "serviceFiles": [
            "src/app/api/programs/admin/offerings/[offeringId]/sessions/route.ts"
          ],
          "serverOutcome": "Cohorte y sesiones en vivo asignadas",
          "negative": "coach no asignado denegado",
          "recovery": "cancelar y reprogramar",
          "requiredVariants": [
            "high_ticket_live",
            "evergreen"
          ]
        }
      ]
    },
    {
